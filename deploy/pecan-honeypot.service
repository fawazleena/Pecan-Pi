[Unit]
Description=Pecan Pi decoy SSH service with automatic nftables blocking
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Standard library only, so the system Python. Root-owned copies in /opt/pecan
# (deploy/install-code.sh), not the user-writable repo. Settings and IP lists are read from
# /etc/pecan (0644, readable under ProtectSystem=strict).
ExecStart=/usr/bin/python3 /opt/pecan/honeypot.py serve
# Stopping the service lifts every block ('-': no error if the table is already gone).
ExecStopPost=-/usr/sbin/nft delete table inet pecan
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=PECAN_BLOCK_SECONDS=3600
# Least privilege: a throwaway user with only the capability nft needs.
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LogsDirectory=pecan
# Never take CPU from Suricata, even under a connection flood.
Nice=10
CPUQuota=10%
MemoryMax=64M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
