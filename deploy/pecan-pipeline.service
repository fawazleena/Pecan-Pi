[Unit]
Description=Pecan Pi alert triage pipeline
After=suricata.service network-online.target
Wants=suricata.service network-online.target

[Service]
Type=simple
# Runs as root: root-owned code and venv in /opt/pecan (deploy/install-code.sh), never the
# user-writable repo. Data (pecan.db, .env, recon_active.json) stays in the repo (PECAN_DATA).
WorkingDirectory=/home/raven/pecan-pi
ExecStart=/opt/pecan/venv/bin/python /opt/pecan/pipeline.py
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PECAN_DATA=/home/raven/pecan-pi
Restart=on-failure
Nice=10
CPUQuota=50%
RestartSec=10

[Install]
WantedBy=multi-user.target
