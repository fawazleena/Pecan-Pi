[Unit]
Description=Pecan Pi alert triage pipeline
After=suricata.service network-online.target
Wants=suricata.service network-online.target

[Service]
Type=simple
WorkingDirectory=/home/raven/pecan-pi
ExecStart=/home/raven/pecan-pi/.venv/bin/python pipeline.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
